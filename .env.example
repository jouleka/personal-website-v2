# Resend contact-form configuration
# Use a sender on a domain verified in Resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=hello@example.com
EMAIL_TO=your-email@example.com

# Cloudflare Turnstile (contact-form bot check)
# Cloudflare's always-pass dummy secret for local development. Production
# reads the real value from the TURNSTILE_SECRET_KEY Worker secret; the server
# refuses dummy secrets on any host other than localhost.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional public sitekey override. Defaults to Cloudflare's always-pass test
# key in development and the jurgenleka.com key in production builds. Do not
# set a test key here if you deploy from this machine: it is baked into builds.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
