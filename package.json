{
  "name": "personal-website-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "next dev",
    "predev": "npm run cf:typegen",
    "prebuild": "npm run cf:typegen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:security": "node --experimental-strip-types --test tests/*.test.mjs",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "pages:build": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@react-email/render": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.2",
    "lenis": "^1.3.26",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.5.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-glob": "file:tools/eslint-glob",
    "postcss": "^8.5.14",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "sharp": "$sharp",
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    }
  }
}
